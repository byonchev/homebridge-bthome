{
  "pluginAlias": "BTHomePlatform",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin Name",
        "description": "The name for this BTHome platform instance in Homebridge",
        "type": "string",
        "default": "BTHome",
        "required": true
      },
      "devices": {
        "title": "Devices",
        "description": "List of devices to connect to and monitor",
        "type": "array",
        "expandable": true,
        "expanded": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Device Name",
              "description": "Friendly name for this device (will appear in the Home app)",
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9\\s']+$"
            },
            "mac": {
              "title": "MAC Address",
              "description": "Bluetooth MAC address of the device (format: XX:XX:XX:XX:XX:XX)",
              "type": "string",
              "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$",
              "required": true
            },
            "encryptionKey": {
              "title": "Encryption Key",
              "description": "32-character hex key used to encrypt the advertisment data.<br/>(leave empty if device doesn't use encryption or it's disabled)",
              "type": "string",
              "pattern": "^$|^[0-9A-Fa-f]{32}$",
              "required": false
            },
            "services": {
              "type": "object",
              "title": "Services",
              "properties": {
                "autoDiscovery": {
                  "title": "Auto-Discovery",
                  "description": "Automatically detect the services of this device based on data received.<br/>Note: Event-based services (like buttons) will only appear after their first use, while sensor services (like temperature) appear immediately when data is received.",
                  "type": "boolean",
                  "default": true,
                  "required": false
                },
                "enabled": {
                  "title": "Enabled Services",
                  "description": "Manually specify which services to create for this device when auto-discovery is disabled.",
                  "expandable": true,
                  "expanded": true,
                  "type": "array",
                  "minItems": 1,
                  "default": [
                    {
                      "type": "battery"
                    }
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "title": "Service Type",
                        "type": "string",
                        "oneOf": [
                          {
                            "title": "Temperature Sensor",
                            "const": "temperature"
                          },
                          {
                            "title": "Humidity Sensor",
                            "const": "humidity"
                          },
                          {
                            "title": "Battery",
                            "const": "battery"
                          },
                          {
                            "title": "Light Sensor",
                            "const": "illuminance"
                          },
                          {
                            "title": "Stateless Switch",
                            "const": "button"
                          },
                          {
                            "title": "Motion Sensor",
                            "const": "motion"
                          },
                          {
                            "title": "Contact Sensor",
                            "const": "contact"
                          }
                        ],
                        "required": true
                      },
                      "options": {
                        "type": "object",
                        "properties": {
                          "lowBatteryThreshold": {
                            "title": "Low Battery Threshold",
                            "description": "Battery percentage below which the device will show as 'Low Battery'",
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "widget": "updown",
                            "condition": {
                              "functionBody": "return model.devices && model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].services && model.devices[arrayIndices[0]].services.enabled && model.devices[arrayIndices[0]].services.enabled[arrayIndices[1]] && model.devices[arrayIndices[0]].services.enabled[arrayIndices[1]].type === 'battery';"
                            },
                            "required": false
                          }
                        },
                        "condition": {
                          "functionBody": "const service = model.devices && model.devices[arrayIndices[0]] && model.devices[arrayIndices[0]].services && model.devices[arrayIndices[0]].services.enabled && model.devices[arrayIndices[0]].services.enabled[arrayIndices[1]] && model.devices[arrayIndices[0]].services.enabled[arrayIndices[1]].type; return service === 'battery';"
                        }
                      }
                    }
                  },
                  "condition": {
                    "functionBody": "return model.devices && model.devices[arrayIndices] && model.devices[arrayIndices].services && model.devices[arrayIndices].services.autoDiscovery === false;"
                  }
                }
              }
            }
          }
        }
      },
      "bluetooth": {
        "title": "Bluetooth Configuration",
        "type": "object",
        "properties": {
          "powerOnTimeout": {
            "title": "Bluetooth Power-On Timeout",
            "description": "Maximum time (in milliseconds) to wait for the Bluetooth adapter to power on before giving up",
            "type": "integer",
            "minimum": 1000,
            "default": 10000,
            "required": true
          }
        }
      }
    }
  }
}
